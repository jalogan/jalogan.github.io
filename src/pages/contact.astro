---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Jack Logan" description="Contact theoretical and computational physicist Jack Logan about scientific research, collaborations, and professional opportunities.">
  <section class="page-intro contact-intro">
    <div class="shell">
      <div class="section-kicker">Get in touch</div>
      <h1>Contact</h1>
      <p>For research discussions, collaborations, or professional opportunities, you're welcome to send me a message.</p>
    </div>
  </section>

  <section class="shell contact-page" aria-labelledby="contact-heading">
    <div class="contact-aside">
      <div class="section-kicker">Let's connect</div>
      <h2 id="contact-heading">Start a conversation.</h2>
      <p>I welcome inquiries about research and professional opportunities.</p>
      <div class="contact-topics" aria-label="Common reasons to get in touch">
        <span>Research & collaboration</span>
        <span>Research scientist opportunities</span>
        <span>Scientific computing & algorithms</span>
      </div>
    </div>

    <div class="contact-form-shell">
      <div class="contact-form-heading">
        <div><div class="section-kicker">Message</div><h2>Send a message</h2></div>
        <span class="contact-form-decoration" aria-hidden="true">↗</span>
      </div>
      <form id="research-contact-form" action="https://formspree.io/f/xrbavorj" method="POST" class="contact-form">
        <div class="contact-form-row">
          <div class="contact-field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Name" />
          </div>
          <div class="contact-field">
            <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="250" placeholder="you@example.com" />
          </div>
        </div>
        <div class="contact-field">
          <label for="contact-subject">Subject <span class="contact-optional">optional</span></label>
          <input id="contact-subject" name="subject" type="text" maxlength="180" placeholder="What would you like to discuss?" />
        </div>
        <div class="contact-field">
          <label for="contact-message">Your message <span aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="message" rows="12" required maxlength="12000" placeholder="Tell me a little about your question, project, or opportunity…"></textarea>
        </div>
        <div class="contact-honeypot" aria-hidden="true"><label for="contact-website-field">Website</label><input id="contact-website-field" type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
        <div class="contact-form-footer">
          <button class="button contact-submit" type="submit">Send message <span aria-hidden="true">↗</span></button>
          <span class="contact-form-note">* Required fields</span>
        </div>
        <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#research-contact-form');
    const status = document.querySelector<HTMLElement>('#contact-form-status');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (form && status && submitButton) {
      form.addEventListener('submit', async (event) => {
        if (!window.fetch) return; // Use the standard Formspree POST when JavaScript/fetch is unavailable.
        event.preventDefault();
        if (!form.reportValidity()) return;
        submitButton.disabled = true;
        submitButton.setAttribute('aria-busy', 'true');
        const originalLabel = submitButton.innerHTML;
        submitButton.textContent = 'Sending…';
        status.textContent = '';
        status.className = 'contact-form-status';
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' },
          });
          if (!response.ok) throw new Error('Form submission failed');
          form.reset();
          status.classList.add('is-success');
          status.textContent = 'Your message was submitted. Thank you for reaching out.';
        } catch {
          status.classList.add('is-error');
          status.textContent = 'Sorry, the message could not be sent. Please try again shortly.';
        } finally {
          submitButton.disabled = false;
          submitButton.removeAttribute('aria-busy');
          submitButton.innerHTML = originalLabel;
          status.focus({ preventScroll: true });
        }
      });
    }
  </script>
</BaseLayout>
